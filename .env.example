# GEMINI_API_KEY: Clé API Google Gemini requise côté serveur pour le cerveau de JARVIS.
# AI Studio injecte automatiquement cette variable depuis les Secrets de l'application.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port d'écoute du serveur (optionnel ; défaut selon la configuration de déploiement).
PORT="3000"

# Sécurisation API pour un déploiement distant.
# Laisser JARVIS_REQUIRE_AUTH="false" pour un usage local inchangé.
# En production, définir un jeton long et aléatoire puis passer JARVIS_REQUIRE_AUTH="true".
JARVIS_REQUIRE_AUTH="false"
JARVIS_API_TOKEN="MY_LONG_RANDOM_API_TOKEN"
# Secret de chiffrement des tokens sociaux (sinon une clé locale 0600 est générée).
JARVIS_TOKEN_SECRET="MY_LOCAL_TOKEN_ENCRYPTION_SECRET"
# Limitation de débit active par défaut (180 req/min, 30 req/min sur les routes coûteuses).
JARVIS_RATE_LIMIT_DISABLED="false"

# URL de base publique utilisée pour les redirections OAuth (recommandé en production).
# SOCIAL_OAUTH_REDIRECT_BASE est prioritaire sur APP_BASE_URL.
SOCIAL_OAUTH_REDIRECT_BASE="MY_PUBLIC_APP_URL"
APP_BASE_URL="MY_PUBLIC_APP_URL"

# APP_URL: URL publique de l'application injectée automatiquement au runtime.
APP_URL="MY_APP_URL"

# Studio Vidéo IA (optionnel) : fournisseur Hugging Face payant à la demande.
# Ne jamais activer sans accord explicite. Sans ce token, le Studio IA renvoie une erreur claire.
HF_TOKEN="MY_HF_TOKEN"

# Social Hub — OAuth officiel TikTok (optionnel, nécessite une application approuvée).
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"

# Social Hub — OAuth officiel Instagram / Meta (optionnel, nécessite une application Meta).
META_APP_ID="MY_META_APP_ID"
META_APP_SECRET="MY_META_APP_SECRET"
